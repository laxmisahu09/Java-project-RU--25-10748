class Contact 
{
    private String name;
    private String phone;

  // constructor
    Contact(String n, String p) 
    {
        name = n;
        phone = p;
    }

    // Getter methods
    String getName() 
    {
        return name;
    }

    String getPhone() 
    {
        return phone;
    }
}

class Directory 
{
    private Contact contacts[];
    private int total;

    // Constructor
    Directory(int size) 
    {
        contacts = new Contact[size];
        total = 0;
    }

    // Adding Contact
    void addContact(String name, String phone) 
    {
        if (total < contacts.length) 
        {
            contacts[total] = new Contact(name, phone);
            total++;

            System.out.println("Contact Saved Successfully");
        } 
        else 
        {
            System.out.println("Directory Full");
        }
    }

    // Search the Contact
    void searchContact(String name) 
    {
        boolean found = false;

        for (int i = 0; i < total; i++) 
        {
            if (contacts[i].getName().equalsIgnoreCase(name)) 
            {
                System.out.println("Contact Found");
                System.out.println("Name  : " + contacts[i].getName());
                System.out.println("Phone : " + contacts[i].getPhone());

                found = true;
                break;
            }
        }

        if (!found) 
        {
            System.out.println("Contact Not Found");
        }
    }

    // Delete Contact
    void deleteContact(String name) 
    {
        int pos = -1;

        for (int i = 0; i < total; i++) 
        {
            if (contacts[i].getName().equalsIgnoreCase(name)) 
            {
                pos = i;
                break;
            }
        }

        if (pos == -1) 
        {
            System.out.println("Contact Not Found");
        } 
        else 
        {
            for (int i = pos; i < total - 1; i++) 
            {
                contacts[i] = contacts[i + 1];
            }

            total--;

            System.out.println("Contact Deleted");
        }
    }

    // Display All Contacts
    void showContacts() 
    {
        if (total == 0) 
        {
            System.out.println("No Contacts Available");
        } 
        else 
        {
            System.out.println("\nSaved Contacts");

            for (int i = 0; i < total; i++) 
            {
                System.out.println("-------------------");
                System.out.println("Name  : " + contacts[i].getName());
                System.out.println("Phone : " + contacts[i].getPhone());
            }
        }
    }
}

public class ContactDirectory 
{
    public static void main(String args[]) 
    {
        Directory d = new Directory(5);

        d.addContact("Rahul", "9876543210");
        d.addContact("Aman", "9123456780");
        d.addContact("Neha", "9988776655");

        System.out.println("\nSearching Contact");
        d.searchContact("Aman");

        System.out.println("\nDisplaying All Contacts");
        d.showContacts();

        System.out.println("\nDeleting Contact");
        d.deleteContact("Rahul");

        System.out.println("\nAfter Deletion");
        d.showContacts();
    }
}
